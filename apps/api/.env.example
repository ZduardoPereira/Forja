# Desenvolvimento local da API (copie para apps/api/.env). Nunca versione o .env.
NODE_ENV=development
PORT=3333
PUBLIC_URL=http://localhost:3333

# Segredo (mín. 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET=

# Código do grupo para criar conta (obrigatório em produção; opcional no desenvolvimento).
INVITE_CODE=amigos

# Vazio = PostgreSQL embutido (PGlite) em apps/api/.data. Para usar um Postgres de verdade:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/forja
DATABASE_URL=

TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info

# Strava (opcional) — veja docs/STRAVA.md
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
