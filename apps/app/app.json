{
  "expo": {
    "name": "FORJA",
    "slug": "forja",
    "version": "2.1.0",
    "description": "FORJA — treinos, evolução e competição entre amigos.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forja",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0B",
    "android": {
      "package": "app.forja.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.forja.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "FORJA",
      "shortName": "FORJA",
      "themeColor": "#0A0A0B",
      "backgroundColor": "#0A0A0B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "O FORJA usa suas fotos para progresso, laudos, dieta e chat.",
          "cameraPermission": "O FORJA usa a câmera para fotos de progresso e do laudo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
