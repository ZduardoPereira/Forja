# Configuração do servidor de produção (docker compose). Copie para .env e preencha.
# Nunca versione o arquivo .env.

# Domínio que aponta para o servidor (ex.: um subdomínio grátis do DuckDNS).
DOMAIN=forja-amigos.duckdns.org

# Segredo longo e aleatório (assina sessões, links de fotos e cifra os tokens do Strava).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET=

# Código do grupo: quem quiser criar conta precisa dele. Passe só para os amigos.
INVITE_CODE=

# Senha do banco PostgreSQL (qualquer texto longo; só o servidor usa).
POSTGRES_PASSWORD=

# Fuso usado nas mensagens automáticas ("marquei treino para sex 18:00").
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info

# Strava (opcional) — veja docs/STRAVA.md
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
